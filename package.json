{
  "name": "reinwell",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && prisma generate --schema prisma/schema.local.prisma && next dev",
    "build": "node scripts/check-process-execution.mjs && prisma generate && prisma generate --schema prisma/schema.local.prisma && next build",
    "start": "next start",
    "setup": "npx prisma generate && npx prisma migrate dev --name init && npx prisma db seed",
    "audit:commands": "node scripts/check-process-execution.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.11.0",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.0",
    "date-fns": "3.3.1",
    "google-auth-library": "11.3.1",
    "lucide-react": "0.344.0",
    "next": "15.5.27",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.11.24",
    "@types/react": "18.3.0",
    "@types/react-dom": "18.2.19",
    "autoprefixer": "10.4.18",
    "postcss": "8.5.28",
    "prisma": "5.11.0",
    "tailwindcss": "3.4.1",
    "tsx": "4.23.15",
    "typescript": "5.3.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    }
  }
}
