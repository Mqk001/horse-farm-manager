generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/local-client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("STAFF")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  emailVerifiedAt DateTime?
  termsAcceptedAt DateTime?
  sessionVersion  Int      @default(0)

  memberships  FarmMember[]
  invitations  FarmInvitation[] @relation("InvitationInvitee")
  sentInvites  FarmInvitation[] @relation("InvitationSender")
  emailVerificationTokens EmailVerificationToken[]
}

model LoginRateLimit {
  key           String   @id
  attempts      Int      @default(0)
  windowStartedAt DateTime
  lockedUntil   DateTime?
  updatedAt     DateTime @updatedAt
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Farm {
  id          String         @id @default(cuid())
  name        String
  code        String         @unique
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  memberships FarmMember[]
  invitations FarmInvitation[]
  horses      Horse[]
  trainers    Trainer[]
  settings    Settings?
}

model FarmMember {
  id        String   @id @default(cuid())
  farmId    String
  userId    String
  role      String   @default("STAFF")
  status    String   @default("ACTIVE")
  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([farmId, userId])
  @@index([userId])
}

model FarmInvitation {
  id          String    @id @default(cuid())
  farmId      String
  email       String
  token       String    @unique
  role        String    @default("STAFF")
  invitedById String
  inviteeId   String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  declinedAt  DateTime?
  createdAt   DateTime  @default(now())

  farm      Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  invitedBy User @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
  invitee   User? @relation("InvitationInvitee", fields: [inviteeId], references: [id], onDelete: SetNull)

  @@index([farmId, email])
  @@index([inviteeId])
}

model Horse {
  id                String    @id @default(cuid())
  farmId            String?
  name              String
  photo             String?
  age               Int?
  breed             String?
  colorMarkings     String?
  notes             String?
  rideIntervalDays  Int       @default(3)
  washIntervalDays  Int       @default(14)
  status            String    @default("ACTIVE")
  feedingPlanJson   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  rides             RideLog[]
  washes            WashLog[]
  vetItems          VetItem[]
  alerts            Alert[]
  farm              Farm?     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  @@index([farmId])
}

model Trainer {
  id        String    @id @default(cuid())
  farmId    String?
  name      String
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  rides     RideLog[]
  farm      Farm?     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  @@index([farmId])
}

model RideLog {
  id              String    @id @default(cuid())
  horseId         String
  horse           Horse     @relation(fields: [horseId], references: [id], onDelete: Cascade)
  dateTime        DateTime  @default(now())
  riderName       String
  trainerId       String?
  trainer         Trainer?  @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  rideType        String    @default("FLAT")
  durationMinutes Int?
  notes           String?
  createdAt       DateTime  @default(now())
}

model WashLog {
  id        String   @id @default(cuid())
  horseId   String
  horse     Horse    @relation(fields: [horseId], references: [id], onDelete: Cascade)
  dateTime  DateTime @default(now())
  type      String   @default("FULL_WASH")
  notes     String?
  createdAt DateTime @default(now())
}

model VetItem {
  id            String    @id @default(cuid())
  horseId       String
  horse         Horse     @relation(fields: [horseId], references: [id], onDelete: Cascade)
  itemType      String
  itemName      String
  lastDoneDate  DateTime?
  intervalDays  Int?
  nextDueDate   DateTime?
  vetName       String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Alert {
  id          String    @id @default(cuid())
  type        String
  severity    String    @default("WARNING")
  title       String
  message     String
  horseId     String?
  horse       Horse?    @relation(fields: [horseId], references: [id], onDelete: Cascade)
  alertKey    String    @unique
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
}

model Settings {
  id                      String   @id @default("global")
  farmId                  String?  @unique
  defaultRideIntervalDays Int      @default(3)
  defaultWashIntervalDays Int      @default(14)
  vetAlertLeadTimeDays    Int      @default(7)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  farm                    Farm?    @relation(fields: [farmId], references: [id], onDelete: Cascade)
}
