# Local development uses the existing SQLite database in prisma/dev.db.
DATABASE_URL="file:./dev.db"
AUTH_SECRET=""
RESEND_API_KEY=""
EMAIL_FROM="Reinwell <onboarding@resend.dev>"
# Optional: region-specific Supabase transaction-pooler host for a direct URI.
# Obtain the exact host from your project's Connect panel.
DATABASE_POOLER_HOST=""

# For Supabase/Postgres deployments, replace DATABASE_URL with the connection
# string from the project's Connect panel. Keep the real value in .env.local
# or the deployment environment; never commit it.
