# Local development uses the existing SQLite database in prisma/dev.db.
DATABASE_URL="file:./dev.db"
AUTH_SECRET=""
RESEND_API_KEY=""
# Test sender: only delivers to the Resend account owner's address.
# Production/Preview: replace with an address on a domain verified in Resend.
EMAIL_FROM="Reinwell <onboarding@resend.dev>"
# Optional: region-specific Supabase transaction-pooler host for a direct URI.
# Obtain the exact host from your project's Connect panel.
DATABASE_POOLER_HOST=""

# For Supabase/Postgres deployments, replace DATABASE_URL with the connection
# string from the project's Connect panel. Keep the real value in .env.local
# or the deployment environment; never commit it.

# Optional Google sign-in. Keep the secret server-side and register the exact
# origin + /api/auth/google/callback in Google Cloud's web OAuth client.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_AUTH_ORIGIN="http://localhost:3000"

# Daily care emails are opt-in per farm member. Enable after applying the migration
# and configuring a verified EMAIL_FROM. APP_URL must be your canonical HTTPS origin.
CARE_REMINDERS_ENABLED="false"
APP_URL="https://getreinwell.com"
# Generate a random secret of at least 32 characters. Never commit the real value.
CRON_SECRET=""
